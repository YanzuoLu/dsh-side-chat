{
  "name": "dsh-side-chat",
  "version": "0.1.0",
  "description": "Full-capability side conversations with header navigation and handoff for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": { ".": "./index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["index.js", "release.json", "dist", "lib/client.js", "cordis.patch.yml"],
  "scripts": { "build": "node scripts/build.mjs" },
  "license": "MIT",
  "author": "Yanzuo Lu",
  "repository": { "type": "git", "url": "https://github.com/YanzuoLu/dsh-side-chat.git" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-subagent"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.0-rc.2",
    "zod": "^4.0.0"
  }
}
